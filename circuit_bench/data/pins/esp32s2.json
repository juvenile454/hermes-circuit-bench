 "rules": [
  {
   "id": "s2.strapping",
   "title": "strapping pin",
   "severity": "caution",
   "pins": [
    0,
    45,
    46
   ],
   "when": {},
   "modes": [
    "*"
   ],
   "message": "Strapping pin: its level at reset is part of the boot configuration (see the ESP32-S2 datasheet). Avoid loads or pull resistors that change it at reset.",
   "source_id": "idf-v6.1-gpio-esp32s2",
   "evidence": "GPIO0, GPIO45 and GPIO46 are strapping pins"
  },
  {
   "id": "s2.spi_flash",
