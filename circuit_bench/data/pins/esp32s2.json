   ],
   "message": "JTAG pin (GPIO39-42: MTCK, MTDO, MTDI, MTMS), usually used for inline debugging.",
   "source_id": "idf-v6.1-gpio-esp32s2",
   "evidence": "GPIO39-42 are usually used for inline debug"
  },
  {
   "id": "s2.input_only",
   "title": "input only",
   "severity": "blocked",
   "pins": [
    46
   ],
   "when": {},
   "modes": [
    "out",
    "pwm",
    "uart_tx",
    "spi_mosi",
    "spi_sck",
    "spi_cs",
    "i2c_sda",
    "i2c_scl",
    "in_pullup",
    "in_pulldown"
   ],
   "message": "GPIO46 is input only and fixed to pull-down: it cannot drive an output, and its pull-down is always on (no pull-up, no switchable pull). Use mode 'in'.",
   "source_id": "idf-v6.1-gpio-esp32s2",
   "evidence": "GPIO46 is fixed to pull-down and is input only"
  },
  {
