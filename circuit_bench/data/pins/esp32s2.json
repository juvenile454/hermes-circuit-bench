   "pins": [
    26,
    27,
    28,
    29,
    30,
    31,
    32
   ],
   "when": {},
   "modes": [
    "*"
   ],
   "message": "Used for the SPI flash and PSRAM of the module. Espressif: not recommended for other uses.",
   "source_id": "idf-v6.1-gpio-esp32s2",
   "evidence": "GPIO26-32 are usually used for SPI flash and PSRAM and not recommended for other uses"
  },
  {
   "id": "s2.jtag",
   "title": "JTAG",
   "severity": "caution",
   "pins": [
    39,
    40,
    41,
    42
   ],
   "when": {},
   "modes": [
