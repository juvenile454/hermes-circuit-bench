  {
   "id": "esp32.strapping",
   "title": "strapping pin",
   "severity": "caution",
   "pins": [
    0,
    2,
    5,
    12,
    15
   ],
   "when": {},
   "modes": [
    "*"
   ],
   "message": "Strapping pin: its level at reset is part of the boot configuration (see the ESP32 datasheet). Avoid loads or pull resistors that change it at reset.",
   "source_id": "idf-v6.1-gpio-esp32",
   "evidence": "GPIO0, GPIO2, GPIO5, GPIO12 (MTDI), and GPIO15 (MTDO) are strapping pins"
  },
